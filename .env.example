APP_ENV=development
POSTGRES_PASSWORD=replace-with-a-long-random-password
SECRET_KEY=change-me-in-production-with-at-least-32-characters
DATABASE_URL=postgresql+psycopg://recruitment:recruitment@postgres:5432/recruitment
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://127.0.0.1:5173","http://127.0.0.1:5174"]
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
FEISHU_MODE=mock
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=
FEISHU_REDIRECT_URI=http://localhost:8000/api/v1/auth/feishu/callback
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_CANDIDATE_TABLE_ID=
FEISHU_BITABLE_FOLLOWUP_TABLE_ID=
PLUGIN_COMPANY_CODE=QXY-TEST
# Optional comma-separated role allowlist for the management console.
# Leave empty to match the plugin scope (any active recruiter in this company).
ADMIN_ROLES=
PUBLIC_WEB_URL=http://localhost:5173
CANDIDATE_CACHE_DAYS=30
DIAGNOSTIC_RETENTION_DAYS=30
EVENT_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=180
FAILED_TASK_RETENTION_DAYS=30
# Cross-BOSS-account duplicate alerts push the moment a hit is detected. This
# window only absorbs identical re-detections of the same viewer/candidate/job
# so re-opening the same candidate does not spam Feishu. 0 = notify every time.
LOOKUP_ALERT_COOLDOWN_MINUTES=30
# Database retention sweep cadence. Production defaults to once per month.
RETENTION_RUN_INTERVAL_DAYS=30
API_BASE_URL=http://localhost:8000/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MOCK_SITE_URL=http://localhost:5174

# Production domain plan (keep local values above for local testing):
# PUBLIC_WEB_URL=https://ai.wuxistar.com
# API_BASE_URL=https://ai.wuxistar.com/api/v1
# VITE_API_BASE_URL=https://ai.wuxistar.com/api/v1
# CORS_ORIGINS=["https://ai.wuxistar.com"]
# FEISHU_REDIRECT_URI=https://ai.wuxistar.com/api/v1/auth/feishu/callback
