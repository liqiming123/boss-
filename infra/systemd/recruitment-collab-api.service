[Unit]
Description=Recruitment Collaboration API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/recruitment-collab/current
EnvironmentFile=/home/ubuntu/apps/recruitment-collab/shared/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/apps/recruitment-collab/shared/venv/bin/python -m uvicorn recruitment_collab.main:app --host 127.0.0.1 --port 18082 --proxy-headers
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=multi-user.target
