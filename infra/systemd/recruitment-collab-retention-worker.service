[Unit]
Description=Recruitment Collaboration data retention worker
After=network-online.target postgresql.service recruitment-collab-api.service
Wants=network-online.target
Requires=recruitment-collab-api.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/recruitment-collab/current
EnvironmentFile=/home/ubuntu/apps/recruitment-collab/shared/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/apps/recruitment-collab/shared/venv/bin/python -m recruitment_collab.workers.data_retention_worker
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=multi-user.target
